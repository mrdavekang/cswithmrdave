  "source": "{\"pxt.json\":\"{\\n  \\\"name\\\": \\\"W3_Radio_Receiver_Starter\\\",\\n  \\\"description\\\": \\\"Week 3: LED sequences and two-board radio. No motors.\\\",\\n  \\\"dependencies\\\": {\\n    \\\"core\\\": \\\"*\\\",\\n    \\\"radio\\\": \\\"*\\\"\\n  },\\n  \\\"files\\\": [\\n    \\\"main.ts\\\"\\n  ],\\n  \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\",\"main.ts\":\"radio.onReceivedString(function (receivedString) {\\n    if (receivedString == \\\"HELP\\\") {\\n        basic.showIcon(IconNames.Diamond)\\n    }\\n})\\nradio.setGroup(23)\\nbasic.showIcon(IconNames.Yes)\\n\"}"
